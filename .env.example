# All variables are optional. DINOHUNTER works offline with zero configuration.

# HTTP port for `dinohunter serve`
PORT=3000

# Enables the optional AI explanation layer (requires: npm install @anthropic-ai/sdk)
ANTHROPIC_API_KEY=
DINO_MODEL=claude-opus-5-5

# Custom JSON-RPC endpoints (public endpoints are used when unset)
RPC_ETHEREUM=
RPC_BASE=
RPC_ROBINHOOD=

# Where the threat database is persisted (default: data/db.json)
DINO_DB_PATH=

# Set to 1 only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=
